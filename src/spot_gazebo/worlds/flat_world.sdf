<?xml version="1.0"?>
<sdf version="1.10">

  <world name="spot_world">

    <physics name="spot_physics" type="dart">
      <!-- Match the MuJoCo physics timestep. -->
      <max_step_size>0.0005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"
    />

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"
    />

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"
    />

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors"
    >
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.65 0.75 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>

      <link name="ground_link">

        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.12 0.22 0.35 1</ambient>
            <diffuse>0.12 0.22 0.35 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

      </link>
    </model>

    <!-- ========================================================= -->
    <!-- Simple LiDAR / mapping obstacles                          -->
    <!-- ========================================================= -->

    <!-- Box in front-right -->
    <model name="test_box">
      <static>true</static>
      <pose>2.5 -1.0 0.5 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.8 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.8 1.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.8 0.25 0.20 1</ambient>
            <diffuse>0.8 0.25 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- Cylinder on the left -->
    <model name="test_cylinder">
      <static>true</static>
      <pose>-2.0 1.5 0.6 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.45</radius>
              <length>1.2</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.45</radius>
              <length>1.2</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.20 0.65 0.25 1</ambient>
            <diffuse>0.20 0.65 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- Long wall -->
    <model name="test_wall">
      <static>true</static>
      <pose>0 3.5 0.75 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4.0 0.20 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4.0 0.20 1.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- Small rectangular obstacle -->
    <model name="test_block">
      <static>true</static>
      <pose>-1.5 -2.5 0.4 0 0 0.45</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 0.5 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 0.5 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.25 0.35 0.85 1</ambient>
            <diffuse>0.25 0.35 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>

</sdf>