<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>spot_description</name>
  <version>0.0.1</version>

  <description>
    ROS 2 robot description package for the Spot quadruped.
  </description>

  <maintainer email="alaa.radhwanmustafa@gmail.com">
    Alaa Radhwan
  </maintainer>

  <!-- Original code: Apache-2.0. Spot meshes in meshes/: BSD-3-Clause (see meshes/LICENSE and THIRD_PARTY.md). -->
  <license>Apache-2.0</license>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>
  <depend>rviz2</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/../"/>
  </export>
</package>